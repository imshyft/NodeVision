<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NodeVision.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NodeVision.App.Controls"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="NodeVision.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Loaded="OnWindowLoaded"
        Title="NodeVision">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>

        <!-- Gray placeholder shown before a camera is selected -->
        <Border x:Name="CameraPlaceholder"
                Background="Gray"/>

        <!-- Main camera / scene view.
             Hidden until the user selects a camera. -->
        <controls:SceneView
            x:Name="SceneViewControl"
            IsVisible="False"/>

        <!-- Camera selection overlay -->
        <Border x:Name="CameraSelectionOverlay"
                Background="#66000000">

            <Border Width="360"
                    Padding="24"
                    CornerRadius="10"
                    Background="#2B2B2B"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">

                    <TextBlock Text="Select Camera"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Choose the camera you want NodeVision to use."
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <ComboBox x:Name="CameraDeviceComboBox"
                              PlaceholderText="Select a camera..."
                              SelectionChanged="OnCameraSelectionChanged"/>

                    <TextBlock x:Name="CameraStatusText"
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <Button x:Name="ConfirmCameraButton"
                            Content="OK"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnConfirmCameraClick"/>

                </StackPanel>

            </Border>
        </Border>

    </Grid>
</Window>