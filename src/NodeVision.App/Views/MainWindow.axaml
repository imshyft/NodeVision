<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NodeVision.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NodeVision.App.Controls"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="NodeVision.App.Views.MainWindow"
        Width="1200"
        Height="760"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Loaded="OnWindowLoaded"
        Title="NodeVision">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.gestureItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Background" Value="#121922"/>
            <Setter Property="BorderBrush" Value="#1E2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.gestureItem TextBlock">
            <Setter Property="Foreground" Value="#AAB6C4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.gestureItem Path">
            <Setter Property="Stroke" Value="#AAB6C4"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid>

        <!-- Gray placeholder shown before a camera is selected -->
        <Border x:Name="CameraPlaceholder"
                Background="Gray"/>

        <!-- Main camera / scene view.
             Hidden until the user selects a camera. -->
        <controls:SceneView
            x:Name="SceneViewControl"
            IsVisible="False"/>

        <!-- Gesture sidebar, shown once the presentation view is active -->
        <Border x:Name="GestureSidebar"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Width="108"
                Background="#D90B1016"
                BorderBrush="#22303F"
                BorderThickness="0,0,1,0"
                IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Text="GESTURES"
                           Foreground="#7F8FA3"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,12"/>

                <StackPanel Grid.Row="1" Spacing="8" Margin="10,0">
                    <Border x:Name="GesturePanItem" Classes="gestureItem">
                        <StackPanel Spacing="4">
                            <Path Data="M12,3 L12,21 M3,12 L21,12 M12,3 L9,6 M12,3 L15,6 M12,21 L9,18 M12,21 L15,18 M3,12 L6,9 M3,12 L6,15 M21,12 L18,9 M21,12 L18,15"/>
                            <TextBlock Text="Pan"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GestureZoomItem" Classes="gestureItem">
                        <StackPanel Spacing="4">
                            <Path Data="M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 M14.5,14.5 L20,20"/>
                            <TextBlock Text="Zoom"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GestureExpandItem" Classes="gestureItem">
                        <StackPanel Spacing="4">
                            <Path Data="M4,9 L9,9 L9,4 M20,9 L15,9 L15,4 M20,15 L15,15 L15,20 M4,15 L9,15 L9,20"/>
                            <TextBlock Text="Expand"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GestureCollapseItem" Classes="gestureItem">
                        <StackPanel Spacing="4">
                            <Path Data="M9,4 L9,9 L4,9 M15,4 L15,9 L20,9 M15,20 L15,15 L20,15 M9,20 L9,15 L4,15"/>
                            <TextBlock Text="Collapse"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2"
                        x:Name="FlipCameraButton"
                        Margin="10,0,10,16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Flip camera"
                        Click="OnFlipCameraClick">
                    <Path Data="M12,3 L12,21 M3,9 L8,12 L3,15 M21,9 L16,12 L21,15"
                          Stroke="#DDE6F2"
                          Fill="Transparent"
                          StrokeThickness="1.6"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Camera selection overlay -->
        <Border x:Name="CameraSelectionOverlay"
                Background="#66000000">

            <Border Width="360"
                    Padding="24"
                    CornerRadius="10"
                    Background="#2B2B2B"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">

                    <TextBlock Text="Select Camera"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Choose the camera you want NodeVision to use."
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <ComboBox Grid.Column="0"
                                  x:Name="CameraDeviceComboBox"
                                  PlaceholderText="Select a camera..."
                                  SelectionChanged="OnCameraSelectionChanged"/>

                        <Button Grid.Column="1"
                                x:Name="CameraSettingsButton"
                                Content="⚙"
                                FontSize="16"
                                Padding="8,4"
                                IsEnabled="False"
                                ToolTip.Tip="Capture format"
                                Click="OnCameraSettingsClick"/>

                    </Grid>

                    <StackPanel x:Name="CameraSettingsPanel"
                                Spacing="8"
                                IsVisible="False">

                        <TextBlock Text="Capture format"
                                   Foreground="LightGray"/>

                        <ComboBox x:Name="CameraModeComboBox"
                                  PlaceholderText="Default (highest fps)"/>

                    </StackPanel>

                    <TextBlock x:Name="SaveFilePathText"
                               Text="Filepath: ..."
                               Foreground="LightGray"
                               TextWrapping="Wrap"/>

                    <Button x:Name="SelectSaveFileButton"
                            Content="Select save file..."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnSelectSaveFileClick"/>

                    <TextBlock x:Name="SaveFileWarningText"
                               Text="Please select a save file before continuing."
                               Foreground="#FF5252"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <TextBlock x:Name="CameraStatusText"
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <Button x:Name="ConfirmCameraButton"
                            Content="OK"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnConfirmCameraClick"/>

                </StackPanel>

            </Border>
        </Border>

        <!-- Hand-tracking debug overlay: landmarks, per-finger state and gesture history (F1) -->
        <Border x:Name="HandDebugOverlay"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10,8"
                CornerRadius="6"
                MaxWidth="360"
                Background="#CC000000"
                IsVisible="False">
            <TextBlock x:Name="HandDebugText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Always-on mode chip so the presenter can see which gesture is armed -->
        <Border x:Name="GestureModeIndicator"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="12,6"
                CornerRadius="14"
                Background="#CC000000"
                IsVisible="False">
            <TextBlock x:Name="GestureModeText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Presenter-facing gesture cheat sheet (F2) -->
        <Border x:Name="GestureHelpOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Padding="16"
                CornerRadius="10"
                MaxWidth="560"
                Background="#E6111820"
                IsVisible="False">
            <StackPanel Spacing="8">
                <TextBlock Text="Gestures"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="GestureHelpText"
                           Foreground="#DDE6F2"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <TextBlock Text="F2: close help"
                           Foreground="#8899AA"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Performance profiler (F3): live rates, stage timings and subsystem toggles -->
        <Border x:Name="PerfOverlay"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="120,0,0,12"
                Padding="12"
                CornerRadius="8"
                Background="#E60B1016"
                IsVisible="False">
            <StackPanel Spacing="6">
                <TextBlock Text="Performance (F3)"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="13"/>
                <TextBlock x:Name="PerfText"
                           Foreground="#B8C6D6"
                           FontFamily="Consolas"
                           FontSize="12"/>
                <CheckBox x:Name="PerfWebcamCheck"
                          Content="Webcam background"
                          IsChecked="True"
                          Foreground="#DDE6F2"
                          IsCheckedChanged="OnPerfTogglesChanged"/>
                <CheckBox x:Name="PerfSceneCheck"
                          Content="Scene"
                          IsChecked="True"
                          Foreground="#DDE6F2"
                          IsCheckedChanged="OnPerfTogglesChanged"/>
                <CheckBox x:Name="PerfInteractionCheck"
                          Content="Interaction overlay"
                          IsChecked="True"
                          Foreground="#DDE6F2"
                          IsCheckedChanged="OnPerfTogglesChanged"/>
                <CheckBox x:Name="PerfInferenceCheck"
                          Content="Hand tracking"
                          IsChecked="True"
                          Foreground="#DDE6F2"
                          IsCheckedChanged="OnPerfTogglesChanged"/>
                <CheckBox x:Name="PerfDebugCheck"
                          Content="Hand debug"
                          IsChecked="False"
                          Foreground="#DDE6F2"
                          IsCheckedChanged="OnPerfTogglesChanged"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>