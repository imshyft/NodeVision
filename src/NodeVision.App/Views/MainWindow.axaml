<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NodeVision.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NodeVision.App.Controls"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="NodeVision.App.Views.MainWindow"
        Width="1200"
        Height="760"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Loaded="OnWindowLoaded"
        Title="NodeVision">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>

        <!-- Gray placeholder shown before a camera is selected -->
        <Border x:Name="CameraPlaceholder"
                Background="Gray"/>

        <!-- Main camera / scene view.
             Hidden until the user selects a camera. -->
        <controls:SceneView
            x:Name="SceneViewControl"
            IsVisible="False"/>

        <!-- Camera selection overlay -->
        <Border x:Name="CameraSelectionOverlay"
                Background="#66000000">

            <Border Width="360"
                    Padding="24"
                    CornerRadius="10"
                    Background="#2B2B2B"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">

                    <TextBlock Text="Select Camera"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Choose the camera you want NodeVision to use."
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                        <ComboBox Grid.Column="0"
                                  x:Name="CameraDeviceComboBox"
                                  PlaceholderText="Select a camera..."
                                  SelectionChanged="OnCameraSelectionChanged"/>

                        <Button Grid.Column="1"
                                x:Name="CameraSettingsButton"
                                Content="⚙"
                                FontSize="16"
                                Padding="8,4"
                                IsEnabled="False"
                                ToolTip.Tip="Capture format"
                                Click="OnCameraSettingsClick"/>

                    </Grid>

                    <StackPanel x:Name="CameraSettingsPanel"
                                Spacing="8"
                                IsVisible="False">

                        <TextBlock Text="Capture format"
                                   Foreground="LightGray"/>

                        <ComboBox x:Name="CameraModeComboBox"
                                  PlaceholderText="Default (highest fps)"/>

                    </StackPanel>

                    <TextBlock x:Name="SaveFilePathText"
                               Text="Filepath: ..."
                               Foreground="LightGray"
                               TextWrapping="Wrap"/>

                    <Button x:Name="SelectSaveFileButton"
                            Content="Select save file..."
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnSelectSaveFileClick"/>

                    <TextBlock x:Name="SaveFileWarningText"
                               Text="Please select a save file before continuing."
                               Foreground="#FF5252"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <TextBlock x:Name="CameraStatusText"
                               Foreground="LightGray"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>

                    <Button x:Name="ConfirmCameraButton"
                            Content="OK"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Click="OnConfirmCameraClick"/>

                </StackPanel>

            </Border>
        </Border>

        <!-- Keyboard gesture test overlay: key mapping while the debug source is active -->
        <Border x:Name="DebugGestureOverlay"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10,8"
                CornerRadius="6"
                Background="#CC000000">
            <TextBlock x:Name="DebugGestureText"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Hand-tracking debug overlay: landmarks, per-finger state and gesture history (F1) -->
        <Border x:Name="HandDebugOverlay"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12"
                Padding="10,8"
                CornerRadius="6"
                MaxWidth="360"
                Background="#CC000000"
                IsVisible="False">
            <TextBlock x:Name="HandDebugText"
                       Foreground="White"
                       FontSize="12"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Always-on mode chip so the presenter can see which gesture is armed -->
        <Border x:Name="GestureModeIndicator"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="12,6"
                CornerRadius="14"
                Background="#CC000000"
                IsVisible="False">
            <TextBlock x:Name="GestureModeText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Presenter-facing gesture cheat sheet (F2) -->
        <Border x:Name="GestureHelpOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Padding="16"
                CornerRadius="10"
                MaxWidth="560"
                Background="#E6111820"
                IsVisible="False">
            <StackPanel Spacing="8">
                <TextBlock Text="Gestures"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="GestureHelpText"
                           Foreground="#DDE6F2"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <TextBlock Text="F2: close help"
                           Foreground="#8899AA"
                           FontSize="11"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>